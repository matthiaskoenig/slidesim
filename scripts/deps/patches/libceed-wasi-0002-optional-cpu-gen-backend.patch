+# CPU Codegen Backends (CPU_GEN=0 leaves them out, for targets without a runtime compiler and dlopen)
+CPU_GEN ?= 1
+ifneq ($(CPU_GEN),0)
 LIBCEED_CONTAINS_CXX = 1
 libceed.c           += $(cpu-gen.c)
 libceed.cpp         += $(cpu-gen.cpp)
@@ -603,6 +605,9 @@ libceed.h           += $(cpu-gen.h)
 CEED_CPU_JIT_CXX    ?= $(CXX)
 CEED_CPU_JIT_OPT    ?= $(OPT)
 CPPFLAGS            += -DCEED_CPU_JIT_OPT='$(CEED_CPU_JIT_OPT)' -DCEED_CPU_JIT_CXX='$(CEED_CPU_JIT_CXX)'
