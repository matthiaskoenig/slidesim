      <rateRule name="rate of the necrosis" variable="necrosis">
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <apply>
            <times/>
            <ci> necrosis_k </ci>
            <apply>
              <minus/>
              <cn sbml:units="dimensionless" type="integer"> 1 </cn>
              <ci> necrosis </ci>
            </apply>
            <ci> necrosis_trigger </ci>
          </apply>
        </math>
      </rateRule>
    </listOfRules>
