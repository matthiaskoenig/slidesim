    <listOfParameters>
      <parameter sboTerm="SBO:0000002" id="f_metabolism" name="flag to change rate of metabolism" value="1" units="dimensionless" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="position" name="position within the lobulus in [0, 1] (pp, pv)" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>position:
0: periportal
1: perivenous/pericentral</p>
          </body>
        </notes>
      </parameter>
      <parameter sboTerm="SBO:0000002" id="pattern" name="flag for zonation pattern" value="0" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>pattern:
0: constant (constant 0.5 over the position)
1: linear_increase (increase from periportal 0 to perivenous 1)
2: sharp_perivenous (high perivenous 1, low otherwise 0)
3: linear_decrease (decrease from periportal 1 to perivenous 0)
4: sharp_periportal (high periportal 1, low otherwise 0)
5: random (uniform draw in [0, 1] per cell)
6: cyp2e1_mouse (measured CYP2E1 profile of the mouse liver, the Hill rise of pattern 2 with K = 0.5847 and n = 1.954, normalized to a maximum of 1)
7: external (protein set from outside via the parameter <code>protein_ext</code> in [0, 1], e.g. the measured CYP2E1 amount per cell)</p>
          </body>
        </notes>
      </parameter>
      <parameter sboTerm="SBO:0000002" id="protein_random" name="constant random value of the cell variant" value="0.5" units="dimensionless" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="protein_ext" name="protein set from outside, in [0, 1]" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Protein of the pattern 7, set from outside, e.g. the CYP2E1 amount
measured on a slide per cell.</p>
          </body>
        </notes>
      </parameter>
      <parameter sboTerm="SBO:0000002" id="cf_protein" name="conversion factor for dimensionless species" value="1" units="per_mmole" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="T_threshold" name="T threshold for necrosis [mM]" value="5" units="mM" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="tsim" name="simulation time" value="0" units="min" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>debug parameter to track time in model coupling</p>
          </body>
        </notes>
      </parameter>
      <parameter sboTerm="SBO:0000002" id="necrosis_k" name="rate of the necrosis" value="1" units="per_min" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="necrosis_w" name="relative width of the ramp of the necrosis trigger" value="0.05" units="dimensionless" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="necrosis" name="necrosis, dead fraction of the cells [0, 1]" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Dead fraction of the cells at a point, irreversible: 1 for a trigger
which lasts, a stable value between 0 and 1 after a transient one. The
trigger is 0 below its threshold, so that a living cell accumulates no
necrosis.</p>
          </body>
        </notes>
      </parameter>
      <parameter sboTerm="SBO:0000002" id="f_tpm" name="global flag for porous media modifications" value="0" units="dimensionless" constant="true"/>
      <parameter sboTerm="SBO:0000002" id="necrosis_trigger" name="condition for necrosis" units="dimensionless" constant="false"/>
      <parameter sboTerm="SBO:0000186" id="SIM_Vmax" name="Vmax for S import" value="NaN" units="mmole_per_min_l" constant="false"/>
      <parameter sboTerm="SBO:0000027" id="SIM_Km_S" name="Km for S import" value="0.5" units="mM" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="PEX_Vmax" name="Vmax for P export" value="NaN" units="mmole_per_min_l" constant="false"/>
      <parameter sboTerm="SBO:0000027" id="PEX_Km_P" name="Km for P export" value="0.5" units="mM" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="S2PT_Vmax" name="Vmax for S to P + T conversion" value="0.05" units="mmole_per_min_l" constant="true"/>
      <parameter sboTerm="SBO:0000027" id="S2PT_Km_S" name="Km for S to P + T conversion" value="0.5" units="mM" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="TDETOX_Vmax" name="Vmax for T detoxification" value="0.005" units="mmole_per_min_l" constant="true"/>
      <parameter sboTerm="SBO:0000027" id="TDETOX_Km_T" name="Km for T detoxification" value="0.5" units="mM" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="BODY2LIVER_S_flux" name="BODY2LIVER_S_flux" value="0" units="mmole_per_min" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="LIVER2BODY_S_flux" name="LIVER2BODY_S_flux" value="0" units="mmole_per_min" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="BODY2LIVER_P_flux" name="BODY2LIVER_P_flux" value="0" units="mmole_per_min" constant="true"/>
      <parameter sboTerm="SBO:0000186" id="LIVER2BODY_P_flux" name="LIVER2BODY_P_flux" value="0" units="mmole_per_min" constant="true"/>
    </listOfParameters>
    <listOfRules>
      <assignmentRule variable="SIM_Vmax">
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <apply>
            <times/>
            <ci> S2PT_Vmax </ci>
            <cn sbml:units="dimensionless" type="integer"> 100 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="PEX_Vmax">
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <apply>
            <times/>
            <ci> S2PT_Vmax </ci>
            <cn sbml:units="dimensionless" type="integer"> 100 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule name="condition for necrosis" variable="necrosis_trigger">
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <piecewise>
            <piece>
              <cn sbml:units="dimensionless" type="integer"> 0 </cn>
              <apply>
                <leq/>
                <ci> T </ci>
                <ci> T_threshold </ci>
              </apply>
            </piece>
            <piece>
              <cn sbml:units="dimensionless" type="integer"> 1 </cn>
              <apply>
                <geq/>
                <ci> T </ci>
                <apply>
                  <times/>
                  <ci> T_threshold </ci>
                  <apply>
                    <plus/>
                    <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                    <ci> necrosis_w </ci>
                  </apply>
                </apply>
              </apply>
            </piece>
            <otherwise>
              <apply>
                <times/>
                <apply>
                  <power/>
                  <apply>
                    <divide/>
                    <apply>
                      <minus/>
                      <ci> T </ci>
                      <ci> T_threshold </ci>
                    </apply>
                    <apply>
                      <times/>
                      <ci> necrosis_w </ci>
                      <ci> T_threshold </ci>
                    </apply>
                  </apply>
                  <cn sbml:units="dimensionless" type="integer"> 2 </cn>
                </apply>
                <apply>
                  <minus/>
                  <cn sbml:units="dimensionless" type="integer"> 3 </cn>
                  <apply>
                    <times/>
                    <cn sbml:units="dimensionless" type="integer"> 2 </cn>
                    <apply>
                      <divide/>
                      <apply>
                        <minus/>
                        <ci> T </ci>
                        <ci> T_threshold </ci>
                      </apply>
                      <apply>
                        <times/>
                        <ci> necrosis_w </ci>
                        <ci> T_threshold </ci>
                      </apply>
                    </apply>
                  </apply>
                </apply>
              </apply>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <assignmentRule name="protein depending on position" variable="protein">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>The protein of every pattern lies in [0, 1]: the random pattern draws in
[0, 1], the patterns of a profile are normalized to a maximum of 1, the
constant pattern is 0.5. The patterns and their profiles are in
<code>pkdb_models/tpm/spt/models/zonation.py</code>.</p>
            <p>The patterns 1 to 4 are generic profiles, pattern 6 is the measured
CYP2E1 profile of the mouse liver
(<code>pkdb_models/tpm/spt/data/mouse_cyp2e1_profile.csv</code>, see the changelog
of the model and <code>pkdb_models/tpm/spt/data/README.md</code>).</p>
          </body>
        </notes>
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <piecewise>
            <piece>
              <cn sbml:units="dimensionless"> 0.5 </cn>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 0 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <ci> position </ci>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <apply>
                <minus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <apply>
                  <divide/>
                  <apply>
                    <power/>
                    <apply>
                      <minus/>
                      <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                      <ci> position </ci>
                    </apply>
                    <cn sbml:units="dimensionless" type="integer"> 10 </cn>
                  </apply>
                  <apply>
                    <plus/>
                    <apply>
                      <power/>
                      <apply>
                        <minus/>
                        <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                        <ci> position </ci>
                      </apply>
                      <cn sbml:units="dimensionless" type="integer"> 10 </cn>
                    </apply>
                    <apply>
                      <power/>
                      <cn sbml:units="dimensionless"> 0.25 </cn>
                      <cn sbml:units="dimensionless" type="integer"> 10 </cn>
                    </apply>
                  </apply>
                </apply>
              </apply>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 2 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <apply>
                <minus/>
                <cn sbml:units="dimensionless"> 1 </cn>
                <ci> position </ci>
              </apply>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 3 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <apply>
                <minus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <apply>
                  <divide/>
                  <apply>
                    <power/>
                    <ci> position </ci>
                    <cn sbml:units="dimensionless" type="integer"> 10 </cn>
                  </apply>
                  <apply>
                    <plus/>
                    <apply>
                      <power/>
                      <ci> position </ci>
                      <cn sbml:units="dimensionless" type="integer"> 10 </cn>
                    </apply>
                    <apply>
                      <power/>
                      <cn sbml:units="dimensionless"> 0.25 </cn>
                      <cn sbml:units="dimensionless" type="integer"> 10 </cn>
                    </apply>
                  </apply>
                </apply>
              </apply>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 4 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <ci> protein_random </ci>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 5 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <apply>
                <minus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <apply>
                      <plus/>
                      <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                      <apply>
                        <power/>
                        <cn sbml:units="dimensionless"> 0.5847 </cn>
                        <cn sbml:units="dimensionless"> 1.954 </cn>
                      </apply>
                    </apply>
                    <apply>
                      <power/>
                      <apply>
                        <minus/>
                        <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                        <ci> position </ci>
                      </apply>
                      <cn sbml:units="dimensionless"> 1.954 </cn>
                    </apply>
                  </apply>
                  <apply>
                    <plus/>
                    <apply>
                      <power/>
                      <apply>
                        <minus/>
                        <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                        <ci> position </ci>
                      </apply>
                      <cn sbml:units="dimensionless"> 1.954 </cn>
                    </apply>
                    <apply>
                      <power/>
                      <cn sbml:units="dimensionless"> 0.5847 </cn>
                      <cn sbml:units="dimensionless"> 1.954 </cn>
                    </apply>
                  </apply>
                </apply>
              </apply>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 6 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <piece>
              <ci> protein_ext </ci>
              <apply>
                <lt/>
                <apply>
                  <abs/>
                  <apply>
                    <minus/>
                    <ci> pattern </ci>
                    <cn sbml:units="dimensionless" type="integer"> 7 </cn>
                  </apply>
                </apply>
                <cn sbml:units="dimensionless" type="e-notation"> 1 <sep/> -6 </cn>
              </apply>
            </piece>
            <otherwise>
              <ci> protein_random </ci>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <rateRule name="tsim rate rule" variable="tsim">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>debug rule to track time in model coupling</p>
          </body>
        </notes>
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <cn sbml:units="dimensionless"> 1 </cn>
        </math>
