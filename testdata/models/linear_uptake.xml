<?xml version="1.0" encoding="UTF-8"?>
<!--
  A linear cell model for the tests of slidesim: the species A_ext in the blood (Vext) is taken
  up into the cell (Vli) at the rate k (A_ext - A) per cell volume, and A decays at the rate d A
  per cell volume. Concentrations in mM, time in s. Written by hand.

  With u = [A_ext] and a = [A]: u' = -k (u - a) Vli / Vext, a' = k (u - a) - d a.
-->
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="linear_uptake" name="linear uptake and decay">
    <listOfCompartments>
      <compartment id="Vext" spatialDimensions="3" size="0.5" constant="true"/>
      <compartment id="Vli" spatialDimensions="3" size="0.5" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="A_ext" compartment="Vext" initialConcentration="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="A" compartment="Vli" initialConcentration="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k" value="0.1" constant="true"/>
      <parameter id="d" value="0.01" constant="true"/>
      <parameter id="uptake_rate" constant="false"/>
    </listOfParameters>
    <listOfRules>
      <assignmentRule variable="uptake_rate">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> k </ci>
            <apply>
              <minus/>
              <ci> A_ext </ci>
              <ci> A </ci>
            </apply>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction id="uptake" reversible="true">
        <listOfReactants>
          <speciesReference species="A_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="A" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> Vli </ci>
              <ci> uptake_rate </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="decay" reversible="false">
        <listOfReactants>
          <speciesReference species="A" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> Vli </ci>
              <ci> d </ci>
              <ci> A </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
