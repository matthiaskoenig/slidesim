{
  "$defs": {
    "BoundarySpec": {
      "additionalProperties": false,
      "description": "Boundary condition on one mesh tag, serialized as\n`{\"tag\": \"...\", \"dirichlet\": 0.1}` or `{\"tag\": \"...\", \"flux\": 1.0}`.",
      "oneOf": [
        {
          "required": [
            "dirichlet"
          ]
        },
        {
          "required": [
            "flux"
          ]
        }
      ],
      "properties": {
        "dirichlet": {
          "description": "Fixed concentration in mM (exclusive with `flux`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "flux": {
          "description": "Inward flux in mM*um/s (exclusive with `dirichlet`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tag": {
          "description": "Name of the boundary tag in the mesh.",
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "type": "object"
    },
    "CellParameter": {
      "additionalProperties": false,
      "description": "A model parameter set per element.",
      "properties": {
        "id": {
          "description": "Parameter id in the model.",
          "type": "string"
        },
        "replace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Replace"
            },
            {
              "type": "null"
            }
          ],
          "description": "Replace the value where a map is high."
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Value (a number or a table over a map)."
        }
      },
      "required": [
        "id",
        "value"
      ],
      "type": "object"
    },
    "CellSolverKind": {
      "description": "How the cell models are solved.",
      "enum": [
        "batched",
        "engine"
      ],
      "type": "string"
    },
    "CellsSpec": {
      "additionalProperties": false,
      "description": "Cell models at the elements of the mesh: one model instance per element, coupled to the\nfields by operator splitting.",
      "properties": {
        "areas": {
          "description": "Area tags of the mesh that hold cells; default all area tags.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "atol": {
          "default": 1e-9,
          "description": "Absolute tolerance of the cell solver, default 1e-9.",
          "format": "double",
          "type": "number"
        },
        "balance": {
          "description": "Spread the work of the cells evenly over the processes, default true: before each step\nof the cells, cells move from processes of more work to processes of less, by their step\nattempts in the step before (the mesh partition stays). A cell takes the same steps\nwherever it is advanced, so the results are the same either way, bit for bit. The\nengine path does not move the cells of a model with events, discontinuities or\nalgebraic rules (its integrator keeps state from one step to the next).",
          "type": "boolean"
        },
        "model": {
          "description": "SBML model, relative to the study file (`Study::load` leaves it as written).",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "description": "Extra assignment rule targets written per cell (states and rules are checked at study\nstart against the compiled model); default none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parameters": {
          "description": "Model parameters set per element.",
          "items": {
            "$ref": "#/$defs/CellParameter"
          },
          "type": "array"
        },
        "rtol": {
          "default": 1e-6,
          "description": "Relative tolerance of the cell solver, default 1e-6.",
          "format": "double",
          "type": "number"
        },
        "solver": {
          "$ref": "#/$defs/CellSolverKind",
          "default": "batched",
          "description": "Solver of the cell models, default `batched`."
        },
        "species": {
          "description": "Model species exchanged with fields.",
          "items": {
            "$ref": "#/$defs/SpeciesLink"
          },
          "type": "array"
        },
        "split_step": {
          "description": "Splitting step in s, must be > 0 and >= `time.dt`.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "time_unit_s": {
          "description": "Seconds per model time unit, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "volumes": {
          "$ref": "#/$defs/VolumeLink",
          "description": "Compartments of the model whose volumes follow the porosity."
        }
      },
      "required": [
        "model",
        "time_unit_s",
        "species",
        "volumes",
        "parameters",
        "split_step"
      ],
      "type": "object"
    },
    "Direction": {
      "additionalProperties": false,
      "description": "The flow direction: that of the gradient of a scene map (e.g. a zonation coordinate).",
      "properties": {
        "g0": {
          "description": "Gradient magnitude in 1/um below which the direction fades to isotropic, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "map": {
          "description": "Id of a map of the scene.",
          "type": "string"
        }
      },
      "required": [
        "map",
        "g0"
      ],
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "properties": {
        "advection": {
          "description": "Advect the field with the Darcy velocity of `Study::perfusion`.",
          "type": "boolean"
        },
        "boundaries": {
          "default": [],
          "description": "Boundary conditions by mesh tag; tags not listed are zero flux.",
          "items": {
            "$ref": "#/$defs/BoundarySpec"
          },
          "type": "array"
        },
        "decay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "minimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "default": 0.0,
          "description": "First-order decay rate in 1/s, must be >= 0 (a number or a table over a map)."
        },
        "diffusion": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Diffusion coefficient in um^2/s, must be > 0 (a number or a table over a map)."
        },
        "id": {
          "description": "Unique field id: an ASCII letter, then ASCII letters, digits and `_` (it names the\nPETSc options prefix of the field, `<id>_`).",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "initial": {
          "default": 0.0,
          "description": "Uniform initial concentration in mM.",
          "format": "double",
          "type": "number"
        },
        "porosity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Fraction of the volume the field lives in (dimensionless), must be > 0 (a number or a\ntable over a map)."
        },
        "source": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "default": 0.0,
          "description": "Source term in mM/s (a number or a table over a map)."
        }
      },
      "required": [
        "id",
        "diffusion"
      ],
      "type": "object"
    },
    "MeshOptions": {
      "additionalProperties": false,
      "properties": {
        "refinements": {
          "default": 0,
          "description": "Number of uniform mesh refinements.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Perfusion": {
      "additionalProperties": false,
      "description": "Darcy perfusion: the pressure field `p` solves `div(K grad p) = 0` with the pressures of\n`boundaries`; the flow is `u = -(K / viscosity) grad p`, with `K` anisotropic: `k_along`\nalong the direction of the `direction` map, `k_across` across it.",
      "properties": {
        "boundaries": {
          "description": "Pressure boundary conditions by mesh tag, at least one, with unique tags.",
          "items": {
            "$ref": "#/$defs/PressureBoundary"
          },
          "minItems": 1,
          "type": "array"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "k_across": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Permeability across the flow direction in um^2, must be > 0."
        },
        "k_along": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Permeability along the flow direction in um^2, must be > 0."
        },
        "viscosity": {
          "description": "Dynamic viscosity in Pa*s, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "viscosity",
        "k_along",
        "k_across",
        "direction",
        "boundaries"
      ],
      "type": "object"
    },
    "PressureBoundary": {
      "additionalProperties": false,
      "properties": {
        "pressure": {
          "description": "Fixed pressure in Pa.",
          "format": "double",
          "type": "number"
        },
        "tag": {
          "description": "Name of the boundary tag in the mesh.",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "pressure"
      ],
      "type": "object"
    },
    "RasterOptions": {
      "additionalProperties": false,
      "description": "The raster pyramid of the fields (`result.raster`).",
      "properties": {
        "levels": {
          "description": "Number of levels, at least 1; level k+1 halves level k.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "origin_um": {
          "description": "Coordinates in um of the corner of pixel (0, 0) of level 0; default: the lower corner of\nthe mesh's bounding box.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "um_per_px": {
          "description": "Pixel size of level 0 in um, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "um_per_px",
        "levels"
      ],
      "type": "object"
    },
    "Replace": {
      "additionalProperties": false,
      "description": "Where the element mean of `map` is above `above`, the parameter takes `value` instead.",
      "properties": {
        "above": {
          "format": "double",
          "type": "number"
        },
        "map": {
          "description": "Id of a map of the scene.",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "map",
        "above",
        "value"
      ],
      "type": "object"
    },
    "ResultOptions": {
      "additionalProperties": false,
      "description": "Options of the result store `result/1`.",
      "properties": {
        "raster": {
          "anyOf": [
            {
              "$ref": "#/$defs/RasterOptions"
            },
            {
              "type": "null"
            }
          ],
          "description": "Also write the fields as a raster pyramid (`raster/<field>/<level>`), the frame of a slide\nimage a viewer overlays the results on."
        }
      },
      "type": "object"
    },
    "SolverOptions": {
      "additionalProperties": false,
      "properties": {
        "linear_rtol": {
          "description": "Relative tolerance of the linear solves of the transport (the residual of each solve\nreduced by it), in (0, 1), default 1e-10. With fixed steps the time integration has no\nerror estimate to derive it from: the study sets it. `-ksp_rtol` in `petsc_options`\noverrides it.",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "petsc_options": {
          "default": "",
          "description": "PETSc options string, e.g. `-ksp_type cg -pc_type jacobi`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "SpeciesLink": {
      "additionalProperties": false,
      "description": "A model species exchanged with a field.",
      "properties": {
        "field": {
          "description": "Id of a field of the study.",
          "type": "string"
        },
        "species": {
          "description": "Species id in the model.",
          "type": "string"
        }
      },
      "required": [
        "species",
        "field"
      ],
      "type": "object"
    },
    "TimeSpec": {
      "additionalProperties": false,
      "properties": {
        "adaptive": {
          "default": false,
          "description": "Use adaptive time stepping.",
          "type": "boolean"
        },
        "dt": {
          "description": "Time step in s (initial step if adaptive), must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "end": {
          "description": "End time in s, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "outputs": {
          "default": [],
          "description": "Output times in s, sorted and within [0, end].",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "end",
        "dt"
      ],
      "type": "object"
    },
    "VolumeLink": {
      "additionalProperties": false,
      "description": "Compartment ids of the model, set per element to the porosity (blood) and 1 - porosity\n(cells).",
      "properties": {
        "blood": {
          "type": "string"
        },
        "cells": {
          "type": "string"
        }
      },
      "required": [
        "blood",
        "cells"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`study/1`: the simulation description.",
  "properties": {
    "cells": {
      "anyOf": [
        {
          "$ref": "#/$defs/CellsSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cell models coupled to the fields; their `outputs` are checked against the model's\nstates and assignment rule targets at study start, not here."
    },
    "fields": {
      "description": "Diffusing fields, at least one, with unique ids.",
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "minItems": 1,
      "type": "array"
    },
    "mesh": {
      "$ref": "#/$defs/MeshOptions",
      "default": {
        "refinements": 0
      }
    },
    "perfusion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Perfusion"
        },
        {
          "type": "null"
        }
      ],
      "description": "Darcy perfusion of the tissue; required for fields with `advection`."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultOptions"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the result store holds besides the mesh values."
    },
    "scene": {
      "description": "Path of the `scene/1` file; relative paths resolve against the\ndirectory of the study file (`Study::load` stores the absolute path).",
      "type": "string"
    },
    "solver": {
      "$ref": "#/$defs/SolverOptions",
      "default": {
        "petsc_options": ""
      }
    },
    "time": {
      "$ref": "#/$defs/TimeSpec"
    },
    "version": {
      "const": "study/1",
      "description": "Contract version, exactly `study/1`.",
      "type": "string"
    }
  },
  "required": [
    "version",
    "scene",
    "fields",
    "time"
  ],
  "title": "Study",
  "type": "object"
}
