{
  "$defs": {
    "BoundarySpec": {
      "additionalProperties": false,
      "description": "Boundary condition on one mesh tag, serialized as\n`{\"tag\": \"...\", \"dirichlet\": 0.1}` or `{\"tag\": \"...\", \"flux\": 1.0}`.",
      "oneOf": [
        {
          "required": [
            "dirichlet"
          ]
        },
        {
          "required": [
            "flux"
          ]
        }
      ],
      "properties": {
        "dirichlet": {
          "description": "Fixed concentration in mM (exclusive with `flux`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "flux": {
          "description": "Inward flux in mM*um/s (exclusive with `dirichlet`).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tag": {
          "description": "Name of the boundary tag in the mesh.",
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "type": "object"
    },
    "Direction": {
      "additionalProperties": false,
      "description": "The flow direction: that of the gradient of a scene map (e.g. a zonation coordinate).",
      "properties": {
        "g0": {
          "description": "Gradient magnitude in 1/um below which the direction fades to isotropic, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "map": {
          "description": "Id of a map of the scene.",
          "type": "string"
        }
      },
      "required": [
        "map",
        "g0"
      ],
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "properties": {
        "advection": {
          "description": "Advect the field with the Darcy velocity of `Study::perfusion`.",
          "type": "boolean"
        },
        "boundaries": {
          "default": [],
          "description": "Boundary conditions by mesh tag; tags not listed are zero flux.",
          "items": {
            "$ref": "#/$defs/BoundarySpec"
          },
          "type": "array"
        },
        "decay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "minimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "default": 0.0,
          "description": "First-order decay rate in 1/s, must be >= 0 (a number or a table over a map)."
        },
        "diffusion": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Diffusion coefficient in um^2/s, must be > 0 (a number or a table over a map)."
        },
        "id": {
          "description": "Unique field id: an ASCII letter, then ASCII letters, digits and `_` (it names the\nPETSc options prefix of the field, `<id>_`).",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "initial": {
          "default": 0.0,
          "description": "Uniform initial concentration in mM.",
          "format": "double",
          "type": "number"
        },
        "porosity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Fraction of the volume the field lives in (dimensionless), must be > 0 (a number or a\ntable over a map)."
        },
        "source": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "default": 0.0,
          "description": "Source term in mM/s (a number or a table over a map)."
        }
      },
      "required": [
        "id",
        "diffusion"
      ],
      "type": "object"
    },
    "MeshOptions": {
      "additionalProperties": false,
      "properties": {
        "refinements": {
          "default": 0,
          "description": "Number of uniform mesh refinements.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Perfusion": {
      "additionalProperties": false,
      "description": "Darcy perfusion: the pressure field `p` solves `div(K grad p) = 0` with the pressures of\n`boundaries`; the flow is `u = -(K / viscosity) grad p`, with `K` anisotropic: `k_along`\nalong the direction of the `direction` map, `k_across` across it.",
      "properties": {
        "boundaries": {
          "description": "Pressure boundary conditions by mesh tag, at least one, with unique tags.",
          "items": {
            "$ref": "#/$defs/PressureBoundary"
          },
          "minItems": 1,
          "type": "array"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "k_across": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Permeability across the flow direction in um^2, must be > 0."
        },
        "k_along": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "map": {
                  "description": "Id of a map of the scene.",
                  "type": "string"
                },
                "points": {
                  "description": "`[value, output]` points, the values strictly increasing.",
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "type": "array"
                }
              },
              "required": [
                "map",
                "points"
              ],
              "type": "object"
            }
          ],
          "description": "Permeability along the flow direction in um^2, must be > 0."
        },
        "viscosity": {
          "description": "Dynamic viscosity in Pa*s, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "viscosity",
        "k_along",
        "k_across",
        "direction",
        "boundaries"
      ],
      "type": "object"
    },
    "PressureBoundary": {
      "additionalProperties": false,
      "properties": {
        "pressure": {
          "description": "Fixed pressure in Pa.",
          "format": "double",
          "type": "number"
        },
        "tag": {
          "description": "Name of the boundary tag in the mesh.",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "pressure"
      ],
      "type": "object"
    },
    "SolverOptions": {
      "additionalProperties": false,
      "properties": {
        "petsc_options": {
          "default": "",
          "description": "PETSc options string, e.g. `-ksp_type cg -pc_type jacobi`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "TimeSpec": {
      "additionalProperties": false,
      "properties": {
        "adaptive": {
          "default": false,
          "description": "Use adaptive time stepping.",
          "type": "boolean"
        },
        "dt": {
          "description": "Time step in s (initial step if adaptive), must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "end": {
          "description": "End time in s, must be > 0.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "outputs": {
          "default": [],
          "description": "Output times in s, sorted and within [0, end].",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "end",
        "dt"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`study/1`: the simulation description.",
  "properties": {
    "fields": {
      "description": "Diffusing fields, at least one, with unique ids.",
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "minItems": 1,
      "type": "array"
    },
    "mesh": {
      "$ref": "#/$defs/MeshOptions",
      "default": {
        "refinements": 0
      }
    },
    "perfusion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Perfusion"
        },
        {
          "type": "null"
        }
      ],
      "description": "Darcy perfusion of the tissue; required for fields with `advection`."
    },
    "scene": {
      "description": "Path of the `scene/1` file; relative paths resolve against the\ndirectory of the study file (`Study::load` stores the absolute path).",
      "type": "string"
    },
    "solver": {
      "$ref": "#/$defs/SolverOptions",
      "default": {
        "petsc_options": ""
      }
    },
    "time": {
      "$ref": "#/$defs/TimeSpec"
    },
    "version": {
      "const": "study/1",
      "description": "Contract version, exactly `study/1`.",
      "type": "string"
    }
  },
  "required": [
    "version",
    "scene",
    "fields",
    "time"
  ],
  "title": "Study",
  "type": "object"
}
